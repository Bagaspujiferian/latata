APP_NAME="NexaTrade Enterprise Engine"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nexatrade.example.com
APP_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_latata
DB_USERNAME=nexatrade
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@nexatrade.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# NexaTrade Enterprise Engine Flags
NEXATRADE_DEMO_SWITCHER=false
NEXATRADE_PAYMENT_DRIVER=midtrans_sandbox
NEXATRADE_WITHDRAWAL_MAKER_CHECKER_THRESHOLD=5000000
NEXATRADE_FLASH_SALE_TTL_MINUTES=15
NEXATRADE_MAX_UNPAID_INVOICES=3

# Midtrans Gateway Credentials (Set in .env.docker, never commit real keys)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# Digiflazz H2H Credentials (Set in .env.docker, never commit real keys)
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_ENDPOINT=https://api.digiflazz.com/v1/transaction
DIGIFLAZZ_SIMULATE=false

VITE_APP_NAME="${APP_NAME}"
